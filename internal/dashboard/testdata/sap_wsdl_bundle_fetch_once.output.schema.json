{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "outcome": {"type": "string", "enum": ["COMPLETE", "HARD_STOP"]},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "system_id": {"type": "string", "const": "gpi_100"},
    "contract_id": {"type": "string", "const": "employee-shop-invoice-wsdl"},
    "request_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "permit_consumed": {"type": "boolean"},
    "network_gets_started": {"type": "integer", "minimum": 0, "maximum": 64},
    "identity": {
      "type": "object",
      "properties": {
        "matches_sealed_manifest": {"type": "boolean"},
        "connection_binding_hmac_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tls_peer_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}
      },
      "required": ["matches_sealed_manifest", "connection_binding_hmac_sha256", "tls_peer_sha256"],
      "additionalProperties": false
    },
    "bundle": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "complete": {"type": "boolean", "const": true},
            "root_document_id": {"type": "string", "pattern": "^doc-[0-9a-f]{32}$"},
            "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "documents": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "document_id": {"type": "string", "pattern": "^doc-[0-9a-f]{32}$"},
                  "kind": {"type": "string", "enum": ["WSDL11", "XSD10", "WS_POLICY"]},
                  "byte_count": {"type": "integer", "minimum": 1, "maximum": 4194304},
                  "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "sanitized_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "media_type": {"type": "string"}
                },
                "required": ["document_id", "kind", "byte_count", "raw_sha256", "sanitized_sha256", "media_type"],
                "additionalProperties": false
              }
            },
            "edges": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "properties": {
                  "from_document_id": {"type": "string", "pattern": "^doc-[0-9a-f]{32}$"},
                  "to_document_id": {"type": "string", "pattern": "^doc-[0-9a-f]{32}$"},
                  "relation": {"type": "string", "enum": ["wsdl_import", "xsd_import", "xsd_include", "xsd_redefine", "policy_reference"]}
                },
                "required": ["from_document_id", "to_document_id", "relation"],
                "additionalProperties": false
              }
            },
            "contract": {
              "type": "object",
              "properties": {
                "wsdl_version": {"type": "string", "const": "1.1"},
                "target_namespaces": {"type": "array", "items": {"type": "string"}},
                "service_qname": {"type": "string"},
                "port_qname": {"type": "string"},
                "binding_qname": {"type": "string"},
                "soap_version": {"type": "string", "enum": ["1.1", "1.2"]},
                "operation": {"type": "string"},
                "input_message_qname": {"type": "string"},
                "output_message_qname": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                "fault_message_qnames": {"type": "array", "items": {"type": "string"}},
                "message_exchange": {"type": "string", "enum": ["request-response", "one-way"]},
                "soap_action_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "soap_action_matches_sealed_expected": {"type": "boolean"},
                "xsd_components": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "namespace": {"type": "string"},
                      "name": {"type": "string"},
                      "kind": {"type": "string", "enum": ["element", "complexType", "simpleType"]},
                      "type": {"type": "string"},
                      "min_occurs": {"type": "string"},
                      "max_occurs": {"type": "string"},
                      "facets": {"type": "object", "additionalProperties": {"type": "string"}}
                    },
                    "required": ["namespace", "name", "kind", "type", "min_occurs", "max_occurs", "facets"],
                    "additionalProperties": false
                  }
                },
                "policy_assertion_qnames": {"type": "array", "items": {"type": "string"}}
              },
              "required": ["wsdl_version", "target_namespaces", "service_qname", "port_qname", "binding_qname", "soap_version", "operation", "input_message_qname", "output_message_qname", "fault_message_qnames", "message_exchange", "soap_action_sha256", "soap_action_matches_sealed_expected", "xsd_components", "policy_assertion_qnames"],
              "additionalProperties": false
            }
          },
          "required": ["complete", "root_document_id", "bundle_sha256", "documents", "edges", "contract"],
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "hard_stop": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "phase": {"type": "string"},
            "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
            "message": {"type": "string"}
          },
          "required": ["phase", "code", "message"],
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "evidence_manifest_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}
  },
  "required": ["schema_version", "outcome", "attempt_id", "system_id", "contract_id", "request_manifest_sha256", "permit_consumed", "network_gets_started", "identity", "bundle", "hard_stop", "evidence_manifest_sha256"],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "outcome": {"const": "COMPLETE"},
        "permit_consumed": {"const": true},
        "network_gets_started": {"minimum": 1},
        "bundle": {"type": "object"},
        "hard_stop": {"type": "null"},
        "evidence_manifest_sha256": {"type": "string"}
      }
    },
    {
      "properties": {
        "outcome": {"const": "HARD_STOP"},
        "bundle": {"type": "null"},
        "hard_stop": {"type": "object"},
        "evidence_manifest_sha256": {"type": "null"}
      }
    }
  ]
}
